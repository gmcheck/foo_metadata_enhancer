IDD_NORMALIZE_EDIT DIALOGEX 0, 0, 400, 320
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit Normalize Group"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Canonical Name (the standard form to apply):", IDC_STATIC, 7, 7, 386, 12
    EDITTEXT        IDC_NORMALIZE_EDIT_CANONICAL, 7, 22, 386, 14, ES_AUTOHSCROLL
    LTEXT           "Aliases (one per line; these will be replaced by canonical name):", IDC_STATIC, 7, 44, 386, 12
    EDITTEXT        IDC_NORMALIZE_EDIT_ALIASES, 7, 59, 386, 130, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT           "Reason (read-only, click to select & copy full text):", IDC_STATIC, 7, 195, 386, 12
    EDITTEXT        IDC_NORMALIZE_EDIT_REASON, 7, 210, 386, 70, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
    LTEXT           "Tip: Edit the list to add/remove aliases. Empty lines are ignored.", IDC_NORMALIZE_EDIT_HINT, 7, 283, 386, 12
    DEFPUSHBUTTON   "OK", IDOK, 290, 298, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 345, 298, 50, 14
END

